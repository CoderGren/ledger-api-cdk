{
  "name": "ledger-api-cdk",
  "version": "0.1.0",
  "description": "Serverless double-entry ledger API on AWS (API Gateway HTTP API, Lambda, DynamoDB) defined with AWS CDK v2 in TypeScript.",
  "author": "Glen Burchfield <glen@gmbxdigital.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ledger-api-cdk": "bin/app.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "synth": "cdk synth --quiet -c jwtIssuer=https://issuer.example.com/ -c jwtAudience=ledger-api",
    "synth:demo": "cdk synth --quiet -c allowUnauthenticated=true",
    "diff": "cdk diff",
    "deploy": "cdk deploy --require-approval broadening",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1177.0",
    "@aws-sdk/lib-dynamodb": "^3.1177.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.7",
    "aws-cdk": "^2.1149.0",
    "aws-cdk-lib": "^2.278.0",
    "aws-sdk-client-mock": "^4.1.0",
    "cdk-nag": "^3.1.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "fast-check": "^4.11.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
